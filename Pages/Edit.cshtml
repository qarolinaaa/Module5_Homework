@page
@model TaskManagerClient.Pages.EditModel

@{
    ViewData["Title"] = "Изменить задачу";
}

<div class="container mt-4">

    <h1>Изменить задачу</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <form method="post">

        <input asp-for="Task.Id" type="hidden" />

        <div class="mb-3">
            <label asp-for="Task.Title" class="form-label">
                Название
            </label>

            <input
                asp-for="Task.Title"
                class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Task.Description" class="form-label">
                Описание
            </label>

            <textarea
                asp-for="Task.Description"
                class="form-control">
            </textarea>
        </div>

        <div class="form-check mb-3">
            <input
                asp-for="Task.IsCompleted"
                class="form-check-input" />

            <label
                asp-for="Task.IsCompleted"
                class="form-check-label">
                Выполнено
            </label>
        </div>

        <button type="submit" class="btn btn-success">
            Сохранить
        </button>

        <a
            asp-page="/Index"
            class="btn btn-secondary">
            Назад
        </a>

    </form>

</div>